{
    "$comment": "Not overwritten by 'copier update' once this file exists (see canary.py's module docstring for how to add an entry, and copier.yml's '_skip_if_exists').",
    "$excluded": "python-poetry/poetry: uses Hugo shortcodes ([x]({{< relref ... >}})) that core mdformat escapes. mdformat-hugo (0.3.0) doesn't fix that and breaks YAML frontmatter parsing on top, dropping the pass rate from 13/16 to 1/16 files. Not a matching-plugin fix the way mdformat-mkdocs was for pydantic, so left untracked.",
    "repos": [
        {
            "excludes": [
                "docs/users/changelog.md"
            ],
            "name": "mdformat",
            "patterns": [
                "docs/**/*.md",
                "*.md"
            ],
            "url": "https://github.com/hukkin/mdformat"
        },
        {
            "excludes": [
                "docs/about/release-notes.md"
            ],
            "name": "mkdocs",
            "patterns": [
                "docs/**/*.md"
            ],
            "url": "https://github.com/mkdocs/mkdocs"
        },
        {
            "excludes": [
                "docs/develop/_changelog.md"
            ],
            "name": "myst-parser",
            "patterns": [
                "docs/**/*.md"
            ],
            "url": "https://github.com/executablebooks/MyST-Parser"
        },
        {
            "excludes": [
                "docs/changelog.md"
            ],
            "name": "pre-commit.com",
            "patterns": [
                "sections/*.md"
            ],
            "url": "https://github.com/pre-commit/pre-commit.com"
        },
        {
            "excludes": [
                "docs/changelog.md"
            ],
            "name": "prek",
            "options": {
                "number": true
            },
            "patterns": [
                "docs/**/*.md"
            ],
            "url": "https://github.com/j178/prek"
        },
        {
            "extensions": [
                "mkdocs"
            ],
            "name": "pydantic",
            "patterns": [
                "docs/**/*.md"
            ],
            "url": "https://github.com/pydantic/pydantic"
        }
    ]
}
